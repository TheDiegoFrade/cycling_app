# Copia este archivo a .env.local (que sí está en .gitignore) y llena los
# valores desde tu proyecto de Supabase: Project Settings → API.
# Sin estos dos valores la app sigue funcionando 100% local (solo IndexedDB,
# sin login ni sync) — Supabase es aditivo, nunca un requisito.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Client ID de tu app en strava.com/settings/api — es público, va en la URL
# de autorización. El Client Secret NUNCA va acá: vive solo como secret de
# las Edge Functions (supabase secrets set STRAVA_CLIENT_SECRET=...).
VITE_STRAVA_CLIENT_ID=
